generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  salary          Decimal            @db.Decimal(12, 2)
  experienceYears Int                @map("experience_years")
  age             Int
  phone           String?
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  properties      PropertyEmployee[]

  @@map("employees")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  materials Material[]

  @@map("suppliers")
}

model Property {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  status       PropertyStatus
  address      String
  startedIn    DateTime           @map("started_in") @db.Date
  endedIn      DateTime?          @map("ended_in") @db.Date
  floorsNumber Int                @map("floors_number")
  area         Decimal            @db.Decimal(12, 2)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartments   Apartment[]
  materials    Material[]
  employees    PropertyEmployee[]

  @@map("properties")
}

model PropertyEmployee {
  propertyId String   @map("property_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  role       String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, employeeId])
  @@map("property_employees")
}

model Apartment {
  id         String          @id @default(uuid()) @db.Uuid
  propertyId String          @map("property_id") @db.Uuid
  status     ApartmentStatus @default(Available)
  floor      Int
  number     String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases Lease[]

  @@unique([propertyId, floor, number])
  @@map("apartments")
}

model Material {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  totalPrice      Decimal        @map("total_price") @db.Decimal(14, 2)
  paidPrice       Decimal        @map("paid_price") @db.Decimal(14, 2)
  status          MaterialStatus
  quantity        Decimal        @db.Decimal(12, 3)
  arriveDate      DateTime       @map("arrive_date") @db.Date
  remainingAmount Decimal        @map("remaining_amount") @db.Decimal(14, 2)
  paymentDate     DateTime?      @map("payment_date") @db.Date
  
  supplierId      String?        @map("supplier_id") @db.Uuid
  propertyId      String?        @map("property_id") @db.Uuid

  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([supplierId, status], map: "idx_materials_supplier_status")
  @@index([supplierId, status, remainingAmount], map: "idx_materials_supplier_status_covering")
  @@map("materials")
}

model ExpenseCategory {
  id       String         @id @default(uuid()) @db.Uuid
  name     String         @unique
  expenses DailyExpense[]

  @@map("expense_categories")
}

model DailyExpense {
  id                String           @id @default(uuid()) @db.Uuid
  sender            String
  amount            Decimal          @db.Decimal(14, 2)
  
  expenseCategoryId String?          @map("expense_category_id") @db.Uuid
  
  expenseDate       DateTime         @map("expense_date") @db.Date
  paidTo            String           @map("paid_to")
  paymentMethod     PaymentMethod    @default(CASH) @map("payment_method")
  receiptNumber     String?          @map("receipt_number")
  receiptImageUrl   String?          @map("receipt_image_url")
  approvedBy        String?          @map("approved_by")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  
  category          ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@map("daily_expenses")
}

model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  nationalId String?  @unique @map("national_id")
  phone      String
  email      String?
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  leases Lease[]

  @@map("tenants")
}

model Lease {
  id          String         @id @default(uuid()) @db.Uuid
  apartmentId String         @map("apartment_id") @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  rentAmount  Decimal        @map("rent_amount") @db.Decimal(12, 2)
  deposit     Decimal?       @db.Decimal(12, 2)
  status      LeaseStatus    @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  apartment Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments  LeasePayment[]

  @@index([tenantId])
  @@index([apartmentId, status])
  @@map("leases")
}

model LeasePayment {
  id              String               @id @default(uuid()) @db.Uuid
  leaseId         String               @map("lease_id") @db.Uuid
  dueDate         DateTime             @map("due_date") @db.Date
  
  totalAmount     Decimal              @map("total_amount") @db.Decimal(14, 2)
  paidAmount      Decimal              @default(0) @map("paid_amount") @db.Decimal(14, 2)
  remainingAmount Decimal              @map("remaining_amount") @db.Decimal(14, 2)
  
  status          PaymentStatus        @default(PENDING)
  notes           String?
  
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  lease        Lease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([leaseId, status])
  @@index([dueDate])
  @@map("lease_payments")
}

model PaymentTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  leasePaymentId  String        @map("lease_payment_id") @db.Uuid
  amountPaid      Decimal       @map("amount_paid") @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now()) @map("payment_date") @db.Timestamptz(6)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  receiptNumber   String?       @map("receipt_number")
  receiptImageUrl String?       @map("receipt_image_url")
  receivedBy      String?       @map("received_by")
  notes           String?

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  leasePayment LeasePayment @relation(fields: [leasePaymentId], references: [id], onDelete: Cascade)

  @@index([leasePaymentId])
  @@map("payment_transactions")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  tableName String      @map("table_name")
  actionType AuditAction @map("action_type")
  oldData   Json?       @map("old_data")
  newData   Json?       @map("new_data")
  recordId  String      @map("record_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tableName, recordId])
  @@map("audit_logs")
}

enum PropertyStatus {
  completed
  under_construction
}

enum MaterialStatus {
  paid
  as_dept
}

enum PaymentMethod {
  CASH
  credit_card
  BANK_TRANSFER
  CHECK
  PETTY_CASH
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum PaymentStatus {
  PENDING   // قيد الانتظار لم يتم دفع أي مبلغ بعد
  PARTIAL   // تم سداد جزء من القسط ويتبقى جزء آخر
  PAID      // تم سداد القسط بالكامل
  OVERDUE   // متأخر عن تاريخ الاستحقاق ولم يُكتمل
}

enum ApartmentStatus {
  Available 
  leased
}

