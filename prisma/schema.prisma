generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyStatus {
  completed
  under_construction
}

enum MaterialStatus {
  paid
  as_dept
}

enum PaymentMethod {
  CASH
  credit_card
  BANK_TRANSFER
  CHECK
  PETTY_CASH
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

model Employee {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  salary          Decimal            @db.Decimal(12, 2)
  experienceYears Int                @map("experience_years")
  age             Int
  phone           String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  properties      PropertyEmployee[]

  @@map("employees")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  materials Material[]

  @@map("suppliers")
}

model Property {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  status       PropertyStatus
  address      String
  startedIn    DateTime           @map("started_in") @db.Date
  endedIn      DateTime?          @map("ended_in") @db.Date
  floorsNumber Int                @map("floors_number")
  area         Decimal            @db.Decimal(12, 2)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees    PropertyEmployee[]
  apartments   Apartment[]
  materials    Material[]

  @@map("properties")
}

model PropertyEmployee {
  propertyId String   @map("property_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  role       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([propertyId, employeeId])
  @@map("property_employees")
}

model Apartment {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  floor      Int
  number     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, floor, number])
  @@map("apartments")
}

model Material {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  totalPrice      Decimal        @map("total_price") @db.Decimal(14, 2)
  paidPrice       Decimal        @map("paid_price") @db.Decimal(14, 2)
  status          MaterialStatus
  quantity        Decimal        @db.Decimal(12, 3)
  arriveDate      DateTime       @map("arrive_date") @db.Date
  remainingAmount Decimal        @map("remaining_amount") @db.Decimal(14, 2)
  paymentDate     DateTime?      @map("payment_date") @db.Date
  supplierId      String         @map("supplier_id") @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([supplierId, status], map: "idx_materials_supplier_status")
  @@map("materials")
}

model ExpenseCategory {
  id       String         @id @default(uuid()) @db.Uuid
  name     String         @unique
  expenses DailyExpense[]

  @@map("expense_categories")
}

model DailyExpense {
  id                String          @id @default(uuid()) @db.Uuid
  sender            String
  amount            Decimal         @db.Decimal(14, 2)
  expenseCategoryId String          @map("expense_category_id") @db.Uuid
  expenseDate       DateTime        @map("expense_date") @db.Date
  paidTo            String          @map("paid_to")
  paymentMethod     PaymentMethod   @default(CASH) @map("payment_method")
  receiptNumber     String?         @map("receipt_number")
  receiptImageUrl   String?         @map("receipt_image_url")
  approvedBy        String?         @map("approved_by")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  category          ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@map("daily_expenses")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  tableName String      @map("table_name")
  actionType AuditAction @map("action_type")
  oldData   Json?       @map("old_data")
  newData   Json?       @map("new_data")
  recordId  String      @map("record_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tableName, recordId])
  @@map("audit_logs")
}