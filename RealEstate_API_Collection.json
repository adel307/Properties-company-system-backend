      { "name": "Create employee", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if ([200, 201].includes(pm.response.code)) { const data = pm.response.json(); pm.collectionVariables.set('employeeId', data.id || data.data?.id); }", "pm.test('Status code is 200/201', () => pm.expect([200, 201]).to.include(pm.response.code));"] } }], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"name\":\"Ahmed Hassan\",\"salary\":18000,\"experienceYears\":7,\"age\":32,\"phone\":\"+201001234567\"}","options":{"raw":{"language":"json"}}}, "url": "{{baseUrl}}/employees" } },
      { "name": "Update employee", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"name\":\"Ahmed Hassan Updated\",\"salary\":19500,\"experienceYears\":8,\"age\":33,\"phone\":\"+201001234567\"}","options":{"raw":{"language":"json"}}}, "url": "{{baseUrl}}/employees/{{employeeId}}" } },
